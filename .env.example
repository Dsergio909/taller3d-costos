# Copia este archivo como .env y llena los valores. El .env nunca se sube a GitHub.

# Contraseña de la base de datos de n8n (solo para docker compose)
POSTGRES_PASSWORD=

# Versión de la imagen de n8n (vacío = la última)
N8N_VERSION=

# Si conectas Telegram o correo para avisarte de las cotizaciones, guarda la
# credencial dentro de n8n (Credenciales), nunca en este archivo ni en el flujo.
