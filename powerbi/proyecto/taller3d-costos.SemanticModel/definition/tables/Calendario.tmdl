table Calendario
	lineageTag: 144493e6-dcd8-5c7a-8d1a-a9f73e4f7fa9

	column Fecha
		dataType: dateTime
		formatString: Short Date
		lineageTag: beeea035-4812-5865-aa5f-e7cea33804e0
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column 'Año'
		dataType: int64
		formatString: 0
		lineageTag: b84d4fbf-35ee-59a1-ac8d-4762ec97c1b4
		summarizeBy: none
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column 'Mes clave'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: dbea33a9-6448-58c1-a85b-ec34506fb77b
		summarizeBy: none
		sourceColumn: [Mes clave]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: d4a78b40-597e-58a4-b5f4-48cad05c95b7
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: 'Mes clave'

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				VAR inicio = MIN(MIN(Pedidos[fecha]), MIN(Gastos[fecha]))
				VAR fin = MAX(MAX(Pedidos[fecha]), MAX(Gastos[fecha]))
				RETURN ADDCOLUMNS(
				    CALENDAR(DATE(YEAR(inicio), 1, 1), DATE(YEAR(fin), 12, 31)),
				    "Año", YEAR([Date]),
				    "Mes clave", YEAR([Date]) * 100 + MONTH([Date]),
				    "Mes", FORMAT([Date], "mmm yy")
				)
