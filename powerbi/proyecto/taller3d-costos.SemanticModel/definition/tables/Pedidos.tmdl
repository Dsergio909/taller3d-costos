	partition Pedidos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "pedidos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    // Cultura en-US: los CSV usan punto decimal y fechas AAAA-MM-DD
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"id_pedido", type text}, {"fecha", type date}, {"canal", type text}, {"id_cliente", type text}, {"estado", type text}, {"origen_datos", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
