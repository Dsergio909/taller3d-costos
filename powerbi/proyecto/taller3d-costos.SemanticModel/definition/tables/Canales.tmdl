table Canales
	lineageTag: 95383f14-b319-520b-b39b-39cc24816200

	column canal
		dataType: string
		lineageTag: ea3e3954-8681-596e-bbda-4a9bf0b1425a
		summarizeBy: none
		sourceColumn: canal

		annotation SummarizationSetBy = Automatic

	column comision_pct
		dataType: double
		formatString: 0%
		lineageTag: ee371da8-4e41-57c9-9183-5fb6b53c3e2d
		summarizeBy: none
		sourceColumn: comision_pct

		annotation SummarizationSetBy = Automatic

	column descripcion
		dataType: string
		isHidden
		lineageTag: 60b2bbac-f023-574c-829e-e253d5397f13
		summarizeBy: none
		sourceColumn: descripcion

		annotation SummarizationSetBy = Automatic

	partition Canales = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "canales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    // Cultura en-US: los CSV usan punto decimal y fechas AAAA-MM-DD
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"canal", type text}, {"comision_pct", type number}, {"descripcion", type text}}, "en-US"),
				    SinMarca = Table.RemoveColumns(Tipos, {"origen_datos"})
				in
				    SinMarca

	annotation PBI_ResultType = Table
