	partition Detalle = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "pedido_detalle.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    // Cultura en-US: los CSV usan punto decimal y fechas AAAA-MM-DD
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"id_pedido", type text}, {"linea", Int64.Type}, {"id_pieza", type text}, {"cantidad", Int64.Type}, {"precio_unitario", type number}, {"descuento_pct", type number}}, "en-US"),
				    SinMarca = Table.RemoveColumns(Tipos, {"origen_datos"})
				in
				    SinMarca

	annotation PBI_ResultType = Table
