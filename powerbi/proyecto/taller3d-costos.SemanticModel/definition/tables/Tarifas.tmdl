	partition Tarifas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "tarifas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    // Cultura en-US: los CSV usan punto decimal y fechas AAAA-MM-DD
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"parametro", type text}, {"valor", type number}, {"unidad", type text}, {"aplica_a", type text}, {"descripcion", type text}}, "en-US"),
				    SinMarca = Table.RemoveColumns(Tipos, {"origen_datos"})
				in
				    SinMarca

