        "jsCode": "// Toma el error de cualquier corrida y lo deja en registro/errores.csv.\nconst e = $input.first().json;\nconst r = { fecha_hora: new Date().toISOString(), flujo: e.workflow?.name || '',\n  id_ejecucion: e.execution?.id || '', nodo: e.execution?.lastNodeExecuted || '',\n  mensaje: (e.execution?.error?.message || 'Error sin mensaje').slice(0, 300) };\nconst esc = (v) => { const s = v === undefined || v === null ? '' : String(v);\n  return /[\",\\n\\r]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s; };\nconst linea = [\"fecha_hora\", \"flujo\", \"id_ejecucion\", \"nodo\", \"mensaje\"].map((c) => esc(r[c])).join(',') + '\\n';\nreturn [{ json: { ...r, linea } }];\n"
      },
